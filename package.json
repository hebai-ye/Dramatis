{
  "name": "dramatis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "多角色扮演酒馆 —— 导演你的角色阵容，让每个角色记住属于自己的故事",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm --filter @dramatis/web dev",
    "desktop": "node tools/desktop/launch.mjs",
    "desktop:prod": "node tools/desktop/launch.mjs --prod",
    "build": "pnpm -r build && pnpm build:sync-admin",
    "build:sync-server": "tsc -p tools/sync-server/tsconfig.json",
    "build:sync-admin": "tsc -p tools/sync-admin/tsconfig.json",
    "typecheck": "pnpm -r typecheck && tsc -p tools/sync-admin/tsconfig.json --noEmit",
    "test": "pnpm -r test && pnpm test:sync-admin",
    "test:sync-admin": "pnpm build:sync-server && pnpm build:sync-admin && node --test tools/sync-admin/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

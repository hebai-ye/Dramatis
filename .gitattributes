# 统一换行符，避免 Windows / macOS / Linux 协作时出现整文件 diff
* text=auto eol=lf

# 二进制资源不参与文本转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.sqlite binary
*.wasm binary
*.zip  binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 同步服务端的配置模板。
#
# 用法：复制成 .env 自己改，或者直接写进 systemd 的 Environment= 里。
# 仓库里不要提交真实的 .env（.gitignore 已经挡住 .env 与 *.env.local）。
#
# 这里没有任何密码或令牌——服务端不需要你的同步密码，它只存凭证哈希与密文。

# 数据库文件放哪（目录不存在会自动创建）
DRAMATIS_SYNC_DATA=/var/lib/dramatis-sync/sync.db

# 监听地址：
#   127.0.0.1  = 只有本机能连（前面挂了 Caddy/Nginx 或 Tailscale 时选它）
#   0.0.0.0    = 直接对外（此时一定要配 HTTPS，见 README）
DRAMATIS_SYNC_HOST=127.0.0.1
DRAMATIS_SYNC_PORT=8787

# 允许哪些网页跨域调用（逗号分隔，必须精确匹配来源）
# 例：http://127.0.0.1:5273,https://你的应用地址
DRAMATIS_SYNC_ORIGINS=

# 可选：直接由本服务提供 HTTPS（自签证书或已有证书时用）
#DRAMATIS_SYNC_TLS_CERT=/etc/ssl/dramatis/fullchain.pem
#DRAMATIS_SYNC_TLS_KEY=/etc/ssl/dramatis/privkey.pem

# 日志（1 = 只报错，不打印每一条请求）
DRAMATIS_SYNC_QUIET=0

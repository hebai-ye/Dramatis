# 仅模板；真实值放到服务器上受 NTFS ACL 保护的 secrets/admin.env。
DRAMATIS_ADMIN_HOST=127.0.0.1
DRAMATIS_ADMIN_PORT=8788
DRAMATIS_ADMIN_SYNC_PORT=8787
DRAMATIS_ADMIN_DATA=
DRAMATIS_ADMIN_AUDIT=
DRAMATIS_ADMIN_BACKUPS=
DRAMATIS_ADMIN_WRITE=0
# 与同步服务 DRAMATIS_SYNC_MAX_MB 的默认值保持一致，单位 MiB。
DRAMATIS_ADMIN_DEFAULT_MAX_MB=96
# 使用 crypto.randomBytes(32).toString('base64url') 生成；不要复用同步凭证。
DRAMATIS_ADMIN_TOKEN=

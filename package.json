{
  "name": "dramatis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "多角色扮演酒馆 —— 导演你的角色阵容，让每个角色记住属于自己的故事",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dramatis/web dev",
    "desktop": "node tools/desktop/launch.mjs",
    "desktop:prod": "node tools/desktop/launch.mjs --prod",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
